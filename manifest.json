{
  "manifest_version": 3,
  "name": "同频 · X → 币安广场",
  "version": "1.0.4",
  "description": "在 Chrome 发布自己的 X 新帖后，自动同步文字、图片和视频到币安广场。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.binance.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://*.amazonaws.com/*",
    "https://*.bnbstatic.com/*"
  ],
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "icons": {
    "16": "extension/icons/icon16.png",
    "32": "extension/icons/icon32.png",
    "48": "extension/icons/icon48.png",
    "128": "extension/icons/icon128.png"
  },
  "action": {
    "default_title": "同频 · 设置与同步记录",
    "default_icon": {
      "16": "extension/icons/icon16.png",
      "32": "extension/icons/icon32.png"
    },
    "default_popup": "extension/popup.html"
  },
  "options_page": "extension/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "extension/bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "extension/parser.js",
        "extension/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
